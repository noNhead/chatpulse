<UserControl x:Class="ChatPulse.Ui.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ChatPulse.Ui"
             Width="620">
    <UserControl.Resources>
        <ui:EqualsConverter x:Key="Eq"/>

        <!-- Every control starts at the same x. Right-aligning them instead would leave their
             left edges at five different positions and the column reads as ragged. -->
        <Thickness x:Key="ControlOffset">266,0,0,0</Thickness>

        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Height" Value="48"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderHi}"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="18,14,10,14">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource Title}" FontWeight="Bold"/>
                    <!-- Deliberately not the resolved path: it contains the account name, and this
                         window ends up in screenshots. -->
                    <TextBlock Text="Saved to %APPDATA%\ChatPulse\settings.json"
                               Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose">
                    <Canvas Width="10" Height="10">
                        <Line X1="0" Y1="0" X2="10" Y2="10" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                        <Line X1="10" Y1="0" X2="0" Y2="10" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                    </Canvas>
                </Button>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}"/>

            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right"
                        Margin="14" Click="OnClose"/>
            </Border>

            <!-- Scrolls: the list of settings is now taller than the window on a 1080p screen. -->
            <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto"
                          MaxHeight="600">
            <StackPanel Margin="18">
                <TextBlock Text="MEASUREMENT" Style="{StaticResource Label}" Foreground="{StaticResource Accent}"/>

                <Grid Style="{StaticResource FieldRow}" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Speed unit" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="The unit the leaderboard column is expressed in"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="msg/s" Tag="PerSecond"
                                         GroupName="Unit" Checked="OnUnitChanged"
                                         IsChecked="{Binding RateUnit, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=PerSecond}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="msg/min" Tag="PerMinute"
                                         GroupName="Unit" Checked="OnUnitChanged"
                                         IsChecked="{Binding RateUnit, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=PerMinute}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="msg/h" Tag="PerHour" Margin="0"
                                         GroupName="Unit" Checked="OnUnitChanged"
                                         IsChecked="{Binding RateUnit, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=PerHour}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Averaging window" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="How far back a chatter's speed is measured"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="15s" Tag="15" GroupName="Win" Checked="OnWindowChanged"
                                         IsChecked="{Binding RateWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=15}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="30s" Tag="30" GroupName="Win" Checked="OnWindowChanged"
                                         IsChecked="{Binding RateWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=30}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="1m" Tag="60" GroupName="Win" Checked="OnWindowChanged"
                                         IsChecked="{Binding RateWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=60}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="5m" Tag="300" GroupName="Win" Checked="OnWindowChanged"
                                         IsChecked="{Binding RateWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=300}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="15m" Tag="900" GroupName="Win" Checked="OnWindowChanged" Margin="0"
                                         IsChecked="{Binding RateWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=900}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Originality window" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="How far back the chat-wide originality looks"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="15s" Tag="15" GroupName="Orig" Checked="OnOriginalityWindowChanged"
                                         IsChecked="{Binding OriginalityWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=15}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="30s" Tag="30" GroupName="Orig" Checked="OnOriginalityWindowChanged"
                                         IsChecked="{Binding OriginalityWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=30}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="1m" Tag="60" GroupName="Orig" Checked="OnOriginalityWindowChanged"
                                         IsChecked="{Binding OriginalityWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=60}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="5m" Tag="300" GroupName="Orig" Checked="OnOriginalityWindowChanged"
                                         IsChecked="{Binding OriginalityWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=300}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="15m" Tag="900" GroupName="Orig" Checked="OnOriginalityWindowChanged" Margin="0"
                                         IsChecked="{Binding OriginalityWindowSec, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=900}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Retention" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="How long messages stay counted for unique %"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="1h" Tag="1" GroupName="Ret" Checked="OnRetentionChanged"
                                         IsChecked="{Binding RetentionHours, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="6h" Tag="6" GroupName="Ret" Checked="OnRetentionChanged"
                                         IsChecked="{Binding RetentionHours, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=6}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="12h" Tag="12" GroupName="Ret" Checked="OnRetentionChanged"
                                         IsChecked="{Binding RetentionHours, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=12}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="24h" Tag="24" GroupName="Ret" Checked="OnRetentionChanged" Margin="0"
                                         IsChecked="{Binding RetentionHours, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=24}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Refresh rate" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="How often the numbers are recomputed"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="100ms" Tag="100" GroupName="Ref" Checked="OnRefreshChanged"
                                         IsChecked="{Binding RefreshMs, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=100}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="250ms" Tag="250" GroupName="Ref" Checked="OnRefreshChanged"
                                         IsChecked="{Binding RefreshMs, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=250}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="500ms" Tag="500" GroupName="Ref" Checked="OnRefreshChanged"
                                         IsChecked="{Binding RefreshMs, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=500}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="1s" Tag="1000" GroupName="Ref" Checked="OnRefreshChanged" Margin="0"
                                         IsChecked="{Binding RefreshMs, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1000}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="History cap per chatter" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Before the oldest start dropping"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="1k" Tag="1000" GroupName="Cap" Checked="OnCapChanged"
                                         IsChecked="{Binding MaxEntriesPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1000}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="5k" Tag="5000" GroupName="Cap" Checked="OnCapChanged"
                                         IsChecked="{Binding MaxEntriesPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=5000}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="20k" Tag="20000" GroupName="Cap" Checked="OnCapChanged"
                                         IsChecked="{Binding MaxEntriesPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=20000}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="No cap" Tag="0" GroupName="Cap" Checked="OnCapChanged" Margin="0"
                                         IsChecked="{Binding MaxEntriesPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Message log" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Messages kept for the detail panel"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="50" Tag="50" GroupName="Log" Checked="OnLogChanged"
                                         IsChecked="{Binding MessageLogPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=50}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="200" Tag="200" GroupName="Log" Checked="OnLogChanged"
                                         IsChecked="{Binding MessageLogPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=200}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="1000" Tag="1000" GroupName="Log" Checked="OnLogChanged"
                                         IsChecked="{Binding MessageLogPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1000}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="5000" Tag="5000" GroupName="Log" Checked="OnLogChanged" Margin="0"
                                         IsChecked="{Binding MessageLogPerUser, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=5000}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="StorageText" Style="{StaticResource BodySmall}"
                           Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>

                <TextBlock Text="OVERLAY" Style="{StaticResource Label}" Foreground="{StaticResource Accent}" Margin="0,14,0,0"/>

                <Grid Style="{StaticResource FieldRow}" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rows" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Chatters shown in the floating window"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left"
                            Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="5" Tag="5" GroupName="Top" Checked="OnTopChanged"
                                         IsChecked="{Binding OverlayTopN, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=5}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="8" Tag="8" GroupName="Top" Checked="OnTopChanged"
                                         IsChecked="{Binding OverlayTopN, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=8}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="10" Tag="10" GroupName="Top" Checked="OnTopChanged"
                                         IsChecked="{Binding OverlayTopN, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=10}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="15" Tag="15" GroupName="Top" Checked="OnTopChanged"
                                         IsChecked="{Binding OverlayTopN, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=15}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="20" Tag="20" GroupName="Top" Checked="OnTopChanged" Margin="0"
                                         IsChecked="{Binding OverlayTopN, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=20}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Opacity" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Lower it to see the game behind"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                Margin="{StaticResource ControlOffset}" VerticalAlignment="Center">
                        <Slider x:Name="OpacitySlider" Width="160" Minimum="0.35" Maximum="1"
                                VerticalAlignment="Center" IsSnapToTickEnabled="False"
                                ValueChanged="OnOpacityChanged"/>
                        <TextBlock x:Name="OpacityValue" Style="{StaticResource Numeric}" Width="44"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Compact rows" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Drop the sparkline and tighten the spacing"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <CheckBox x:Name="CompactToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Left"
                              Margin="{StaticResource ControlOffset}"
                              VerticalAlignment="Center" Click="OnCompactChanged"/>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Always on top" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Keep the overlay above other windows"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <CheckBox x:Name="TopmostToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Left"
                              Margin="{StaticResource ControlOffset}"
                              VerticalAlignment="Center" Click="OnTopmostChanged"/>
                </Grid>

                <TextBlock Text="SESSION" Style="{StaticResource Label}" Foreground="{StaticResource Accent}" Margin="0,14,0,0"/>

                <Grid Style="{StaticResource FieldRow}" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Demo feed" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Synthetic chat, no Twitch connection"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Button x:Name="DemoButton" Style="{StaticResource GhostButton}" Content="Start demo"
                            HorizontalAlignment="Left" Margin="{StaticResource ControlOffset}"
                            VerticalAlignment="Center" Click="OnStartDemo"/>
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reset statistics" Style="{StaticResource Body}" FontWeight="Medium"/>
                        <TextBlock Text="Clears every counter and starts the session over"
                                   Style="{StaticResource BodySmall}" Foreground="{StaticResource TextFaint}"/>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Reset" Foreground="{StaticResource Bad}"
                            HorizontalAlignment="Left" Margin="{StaticResource ControlOffset}"
                            VerticalAlignment="Center" Click="OnReset"/>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
