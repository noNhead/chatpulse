<Window x:Class="ChatPulse.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ChatPulse.Ui.Controls"
        xmlns:ui="clr-namespace:ChatPulse.Ui"
        Title="ChatPulse Overlay"
        Width="330" Height="434" MinWidth="250" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ui:InverseBoolToVisibility x:Key="NotBoolVis"/>
        <ui:NonEmptyToVisibility x:Key="NonEmpty"/>
    </Window.Resources>

    <Grid Margin="8">
        <!-- A 1px border does not separate this from a bright game capture; broadcast widgets
             need a soft drop shadow to sit on top of arbitrary content. -->
        <Border x:Name="Card" CornerRadius="14" BorderThickness="1" BorderBrush="#47A970FF"
                MouseLeftButtonDown="OnDragCard">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF13131C" Offset="0"/>
                    <GradientStop Color="#FF0A0A10" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.75" Color="Black"/>
            </Border.Effect>

            <DockPanel>
                <!-- header -->
                <Grid DockPanel.Dock="Top" Height="38" Margin="12,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Animated="False": this window is layered, so a continuous animation
                             would re-render the whole surface in software every vsync. -->
                        <c:LiveDot x:Name="Dot" DotSize="6" Animated="False" VerticalAlignment="Center"/>
                        <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TOP CHATTERS" Style="{StaticResource Label}"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="ChannelText" Style="{StaticResource LabelSmall}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The unit belongs here once, not stamped next to all ten numbers. -->
                        <TextBlock x:Name="UnitText" Style="{StaticResource LabelSmall}"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                   Visibility="{Binding ElementName=Card, Path=IsMouseOver, Converter={StaticResource NotBoolVis}}"/>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ElementName=Card, Path=IsMouseOver, Converter={StaticResource BoolVis}}">
                            <!-- OBS captures the window itself, so it does not need to be visually
                                 on top; unpinning lets it drop behind everything else. -->
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Width="24" Height="24"
                                    Click="OnTogglePin">
                                <Grid Width="13" Height="13">
                                    <Canvas x:Name="PinnedGlyph" Width="13" Height="13">
                                        <Line X1="1" Y1="11.5" X2="12" Y2="11.5" Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
                                        <Line X1="6.5" Y1="1" X2="6.5" Y2="8.5" Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
                                        <Line X1="3" Y1="4.5" X2="6.5" Y2="1" Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
                                        <Line X1="10" Y1="4.5" X2="6.5" Y2="1" Stroke="{StaticResource Accent}" StrokeThickness="1.4"/>
                                    </Canvas>
                                    <Canvas x:Name="UnpinnedGlyph" Width="13" Height="13" Visibility="Collapsed">
                                        <Line X1="1" Y1="1.5" X2="12" Y2="1.5" Stroke="{StaticResource TextDim}" StrokeThickness="1.4"/>
                                        <Line X1="6.5" Y1="4.5" X2="6.5" Y2="12" Stroke="{StaticResource TextDim}" StrokeThickness="1.4"/>
                                        <Line X1="3" Y1="8.5" X2="6.5" Y2="12" Stroke="{StaticResource TextDim}" StrokeThickness="1.4"/>
                                        <Line X1="10" Y1="8.5" X2="6.5" Y2="12" Stroke="{StaticResource TextDim}" StrokeThickness="1.4"/>
                                    </Canvas>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnToggleCompact"
                                    ToolTip="Compact rows">
                                <Canvas Width="12" Height="12">
                                    <Line X1="0" Y1="3" X2="12" Y2="3" Stroke="{StaticResource TextMid}" StrokeThickness="1.3"/>
                                    <Line X1="0" Y1="9" X2="12" Y2="9" Stroke="{StaticResource TextMid}" StrokeThickness="1.3"/>
                                </Canvas>
                            </Button>
                            <Button Style="{StaticResource CloseButton}" Width="24" Height="24" Click="OnClose">
                                <Canvas Width="9" Height="9">
                                    <Line X1="0" Y1="0" X2="9" Y2="9" Stroke="{StaticResource TextMid}" StrokeThickness="1.3"/>
                                    <Line X1="9" Y1="0" X2="0" Y2="9" Stroke="{StaticResource TextMid}" StrokeThickness="1.3"/>
                                </Canvas>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="#29A970FF"/>

                <!-- footer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#24A970FF" BorderThickness="0,1,0,0">
                    <Grid Height="28" Margin="12,0">
                        <TextBlock x:Name="GlobalRate" Style="{StaticResource Numeric}"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveText" Style="{StaticResource LabelSmall}"
                                       Foreground="{StaticResource TextDim}"/>
                            <Rectangle Width="3" Height="3" Fill="{StaticResource TextFaint}" Margin="8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText" Style="{StaticResource LabelSmall}"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- rows -->
                <ItemsControl x:Name="RowsHost" Margin="8,6" ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="{Binding RowHeight}" CornerRadius="7" Background="{Binding RankTint}"
                                    Margin="0,0,0,0">
                                <Grid Margin="8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Name and value share one row so their baselines line up;
                                         the bar sits underneath. -->
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Numeric}"
                                                   Foreground="{Binding RankBrush}" FontWeight="{Binding RankWeight}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   Style="{StaticResource BodySmall}" FontWeight="Medium"
                                                   Foreground="{Binding UserBrush}" Margin="7,0,6,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RateText}"
                                                   Style="{StaticResource MetricSmall}"/>
                                    </Grid>
                                    <!-- One colour for every bar: the per-user hue belongs on the
                                         name. Ten different hues make identical lengths look
                                         different, which defeats the point of a bar. -->
                                    <c:RateBar Grid.Row="1" Height="3" Margin="23,3,0,4"
                                               Fraction="{Binding BarFraction}"
                                               BarColor="{Binding Source={StaticResource Accent}, Path=Color}"
                                               Visibility="{Binding ShowBar, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- resize grip -->
        <Thumb x:Name="Grip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" DragDelta="OnResize" Opacity="0.001"/>
    </Grid>
</Window>
