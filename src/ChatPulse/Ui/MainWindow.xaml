<Window x:Class="ChatPulse.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ChatPulse.Ui.Controls"
        xmlns:ui="clr-namespace:ChatPulse.Ui"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ChatPulse"
        Width="1320" Height="820" MinWidth="1020" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- CaptionHeight matches the title bar, so Windows handles dragging, double-click maximise,
         Aero Snap and edge resizing natively. Interactive controls opt out via
         shell:WindowChrome.IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ui:InverseBoolToVisibility x:Key="NotBoolVis"/>
        <ui:EqualsConverter x:Key="Eq"/>
        <ui:FractionStar x:Key="Frac"/>
        <ui:RemainderStar x:Key="FracRest"/>

        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>

            <!-- ================= TITLE BAR ================= -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid Height="52" Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <c:LogoMark Grid.Column="0" TileSize="28" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CHATPULSE" FontFamily="{StaticResource UiFont}" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource Text}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="chat analytics" Style="{StaticResource LabelSmall}"/>
                    </StackPanel>

                    <!-- Status pill. No channel name here: it is already in the input to the right. -->
                    <Border Grid.Column="2" Margin="20,0,0,0" CornerRadius="7" Padding="7,5,10,5"
                            VerticalAlignment="Center" BorderThickness="1"
                            Background="{StaticResource Surface}"
                            BorderBrush="{Binding StatusBrush}">
                        <StackPanel Orientation="Horizontal">
                            <c:LiveDot Active="{Binding StatusActive}" DotSize="6"
                                       DotColor="{Binding StatusBrush.Color}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Label}"
                                       Foreground="{Binding StatusBrush}" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="190">
                            <!-- Deliberately not bound. The snapshot tick rewrites the view model
                                 four times a second, and a two-way binding would push that stale
                                 value back into the box between keystrokes. The box owns its own
                                 text; TextChanged pushes it into the state, never the reverse. -->
                            <TextBox x:Name="ChannelBox" Style="{StaticResource Input}"
                                     Padding="22,0,10,0"
                                     TextChanged="OnChannelTextChanged"
                                     GotKeyboardFocus="OnChannelFocused"
                                     PreviewMouseLeftButtonDown="OnChannelMouseDown"
                                     KeyDown="OnChannelKeyDown"/>
                            <TextBlock Text="#" Style="{StaticResource Body}" Foreground="{StaticResource TextFaint}"
                                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Connecting is the call to action; disconnecting must not compete with it,
                             so the two states are separate buttons rather than one restyled button. -->
                        <Button Margin="8,0,0,0" Click="OnToggleConnection" Content="Connect"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding Connected, Converter={StaticResource NotBoolVis}}"/>
                        <Button x:Name="ConnectButton" Margin="8,0,0,0" Click="OnToggleConnection"
                                Content="{Binding ConnectLabel}"
                                Style="{StaticResource GhostButton}"
                                Visibility="{Binding Connected, Converter={StaticResource BoolVis}}"/>

                        <Border Width="1" Height="22" Background="{StaticResource Border}" Margin="14,0,6,0"/>

                        <Button x:Name="OverlayButton" Style="{StaticResource IconButton}" Click="OnToggleOverlay"
                                ToolTip="Floating overlay">
                            <Path Data="M2,3 H18 V15 H2 Z M10,9 H16 V14 H10 Z" Stretch="Uniform" Width="15" Height="15"
                                  Stroke="{StaticResource TextMid}" StrokeThickness="1.4" Fill="Transparent"/>
                        </Button>

                        <Button Style="{StaticResource IconButton}" Click="OnOpenSettings" ToolTip="Settings">
                            <Canvas Width="16" Height="16">
                                <Line X1="1" Y1="4.5" X2="15" Y2="4.5" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                                <Line X1="1" Y1="11.5" X2="15" Y2="11.5" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                                <Ellipse Canvas.Left="4" Canvas.Top="2" Width="5" Height="5"
                                         Stroke="{StaticResource TextMid}" StrokeThickness="1.4" Fill="{StaticResource BgPanel}"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="9" Width="5" Height="5"
                                         Stroke="{StaticResource TextMid}" StrokeThickness="1.4" Fill="{StaticResource BgPanel}"/>
                            </Canvas>
                        </Button>

                        <Button Style="{StaticResource IconButton}" Click="OnMinimize" Margin="6,0,0,0">
                            <Line X1="0" Y1="0" X2="11" Y2="0" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnMaximize">
                            <Rectangle Width="10" Height="10" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnClose">
                            <Canvas Width="11" Height="11">
                                <Line X1="0" Y1="0" X2="11" Y2="11" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                                <Line X1="11" Y1="0" X2="0" Y2="11" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= FOOTER ================= -->
            <Grid DockPanel.Dock="Bottom" Height="24" Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="5" Height="5" Fill="{Binding FooterBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FooterMessage}" Style="{StaticResource BodySmall}"
                               Foreground="{Binding FooterBrush}" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FooterHint}" Style="{StaticResource BodySmall}"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
            </Grid>

            <!-- ================= BODY ================= -->
            <Grid Margin="12,12,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- stat strip -->
                <UniformGrid Grid.Row="0" Rows="1" Height="124" Margin="0,0,0,10">
                    <UniformGrid.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </UniformGrid.Resources>

                    <Border>
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CHAT SPEED" Style="{StaticResource Label}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ChatRate}" Style="{StaticResource Metric}"/>
                                <TextBlock Text="{Binding RateUnit}" Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextDim}" Margin="5,0,0,4"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <c:Sparkline Grid.Row="3" Height="18" Values="{Binding GlobalSpark}"
                                         Fill="{Binding Source={StaticResource Accent}, Path=Color}"/>
                            <TextBlock Grid.Row="4" Text="{Binding PeakRate}" Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextFaint}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <Border>
                        <StackPanel Margin="14">
                            <TextBlock Text="MESSAGES" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding TotalMessages}" Style="{StaticResource Metric}"/>
                                <TextBlock Text="total" Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextDim}" Margin="5,0,0,4"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WindowMessages}" Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border>
                        <StackPanel Margin="14">
                            <TextBlock Text="CHATTERS" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Chatters}" Style="{StaticResource Metric}"/>
                                <TextBlock Text="tracked" Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextDim}" Margin="5,0,0,4"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveChatters}" Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border>
                        <StackPanel Margin="14">
                            <TextBlock Text="ORIGINALITY" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Originality}" Style="{StaticResource Metric}"/>
                                <TextBlock Text="%" Style="{StaticResource BodySmall}"
                                           Foreground="{Binding OriginalityBrush}" Margin="5,0,0,4"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OriginalitySub}" Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0">
                        <StackPanel Margin="14">
                            <TextBlock Text="SESSION" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding Session}" Style="{StaticResource Metric}"
                                       FontSize="21" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SessionSub}" Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- leaderboard + detail -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Panel}" Background="{StaticResource Surface}">
                        <DockPanel>
                            <!-- header -->
                            <Grid DockPanel.Dock="Top" Height="46" Margin="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Top chatters" Style="{StaticResource Title}"/>
                                    <TextBlock Text="{Binding RowCount}" Style="{StaticResource Numeric}"
                                               Foreground="{StaticResource TextFaint}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Grid Width="190">
                                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                                                 FontSize="12" Padding="28,0,10,0"
                                                 TextChanged="OnSearchChanged"/>
                                        <Canvas Width="13" Height="13" Margin="11,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                            <Ellipse Canvas.Left="0" Canvas.Top="0" Width="9" Height="9"
                                                     Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                                            <Line X1="8" Y1="8" X2="12.5" Y2="12.5"
                                                  Stroke="{StaticResource TextDim}" StrokeThickness="1.3"/>
                                        </Canvas>
                                        <TextBlock x:Name="SearchPlaceholder" Text="Filter chatters"
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextFaint}"
                                                   Margin="30,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <Border Style="{StaticResource SegmentGroup}" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="Speed" Tag="Rate"
                                                         GroupName="Sort" Checked="OnSortChanged"
                                                         IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Rate}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="Messages" Tag="Messages"
                                                         GroupName="Sort" Checked="OnSortChanged"
                                                         IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Messages}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="Unique %" Tag="Unique"
                                                         GroupName="Sort" Checked="OnSortChanged"
                                                         IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Unique}"/>
                                            <RadioButton Style="{StaticResource Segment}" Content="Session total" Tag="Total"
                                                         GroupName="Sort" Checked="OnSortChanged" Margin="0"
                                                         IsChecked="{Binding SortKey, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Total}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}"/>

                            <!-- column titles -->
                            <Grid DockPanel.Dock="Top" Height="26" Background="{StaticResource BgPanel}" Margin="0">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="1" Text="CHATTER" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="2" Text="SHARE OF TOP SPEED" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="3" Text="PULSE" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding RateUnitUpper}" Style="{StaticResource ColHeader}"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="COUNTED" Style="{StaticResource ColHeader}"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="UNIQUE" Style="{StaticResource ColHeader}"
                                               TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="LAST" Style="{StaticResource ColHeader}"
                                               TextAlignment="Right"/>
                                </Grid>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}"/>

                            <!-- empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasRows, Converter={StaticResource NotBoolVis}}">
                                <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Title}"
                                           Foreground="{StaticResource TextMid}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EmptySubtitle}" Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextFaint}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- rows -->
                            <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}"
                                     Background="Transparent" BorderThickness="0"
                                     Visibility="{Binding HasRows, Converter={StaticResource BoolVis}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionMode="Single"
                                     PreviewMouseLeftButtonUp="OnRowClicked">
                                <ListBox.Resources>
                                    <!-- Implicit style: the ListBox builds its own ScrollViewer, so the
                                         thin rail has to be applied from inside its resource scope. -->
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEven}" Value="False">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{StaticResource RowAlt}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{StaticResource RowHover}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{StaticResource RowSel}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="48" Margin="14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="230"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="108"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                                       Style="{StaticResource Numeric}"
                                                       Foreground="{Binding RankBrush}" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="26" Height="26" CornerRadius="8"
                                                        Background="{Binding AvatarBrush}">
                                                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource UiFont}"
                                                               FontSize="11" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}"
                                                           FontWeight="Medium" Foreground="{Binding UserBrush}"
                                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                <!-- Only badges that carry information at a glance. Subs are the
                                                     majority of a big chat, so a "sub" chip on every row is noise. -->
                                                <Border Style="{StaticResource Chip}" Margin="5,0,0,0"
                                                        Background="#243BE39A"
                                                        Visibility="{Binding IsMod, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="MOD" Style="{StaticResource LabelSmall}"
                                                               Foreground="{StaticResource Good}"/>
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="5,0,0,0"
                                                        Background="#24E05FA8"
                                                        Visibility="{Binding IsVip, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="VIP" Style="{StaticResource LabelSmall}"
                                                               Foreground="{StaticResource Vip}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Magnitude bar filling the gap: at a glance you see how far ahead
                                                 the leader is, which a column of digits never conveys. -->
                                            <c:RateBar Grid.Column="2" Height="6" Margin="0,0,16,0"
                                                       VerticalAlignment="Center"
                                                       Fraction="{Binding BarFraction}"
                                                       BarColor="{Binding Source={StaticResource Accent}, Path=Color}"/>

                                            <c:Sparkline Grid.Column="3" Height="22" Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Values="{Binding Spark}"
                                                         Fill="{Binding Source={StaticResource Accent}, Path=Color}"/>

                                            <TextBlock Grid.Column="4" Text="{Binding RateText}"
                                                       Style="{StaticResource MetricSmall}" TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding CountedText}"
                                                       Style="{StaticResource Numeric}" TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding UniqueText}"
                                                       Style="{StaticResource Numeric}" TextAlignment="Right"
                                                       Foreground="{Binding UniqueBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding LastText}"
                                                       Style="{StaticResource Numeric}" TextAlignment="Right"
                                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- detail panel -->
                    <ContentControl Grid.Column="1" Width="376" Margin="10,0,0,0"
                                    Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource Panel}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="14,12,8,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="11" Background="{Binding DetailBrush}">
                                        <TextBlock Text="{Binding DetailInitial}" FontFamily="{StaticResource UiFont}"
                                                   FontSize="16" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DetailName}" Style="{StaticResource Title}"
                                                       FontWeight="Bold" Foreground="{Binding DetailBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <!-- Anchors the panel to the table: the selected chatter is often
                                                 ranked well below the visible rows. -->
                                            <TextBlock Text="{Binding DetailRank}" Style="{StaticResource Numeric}"
                                                       Foreground="{Binding DetailRankBrush}" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Style="{StaticResource Chip}" Background="#243BE39A" Margin="0,0,4,0"
                                                    Visibility="{Binding DetailMod, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="MOD" Style="{StaticResource LabelSmall}"
                                                           Foreground="{StaticResource Good}"/>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="#24E05FA8" Margin="0,0,4,0"
                                                    Visibility="{Binding DetailVip, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="VIP" Style="{StaticResource LabelSmall}"
                                                           Foreground="{StaticResource Vip}"/>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="#24A970FF" Margin="0,0,4,0"
                                                    Visibility="{Binding DetailSub, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="SUB" Style="{StaticResource LabelSmall}"
                                                           Foreground="{StaticResource Accent}"/>
                                            </Border>
                                            <TextBlock Text="{Binding DetailFirstSeen}" Style="{StaticResource BodySmall}"
                                                       Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                                            Click="OnCloseDetail" VerticalAlignment="Top">
                                        <Canvas Width="10" Height="10">
                                            <Line X1="0" Y1="0" X2="10" Y2="10" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                                            <Line X1="10" Y1="0" X2="0" Y2="10" Stroke="{StaticResource TextMid}" StrokeThickness="1.4"/>
                                        </Canvas>
                                    </Button>
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Border}"/>

                                <ScrollViewer Style="{StaticResource ThinScrollViewer}"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="14">
                                        <!-- the three headline numbers -->
                                        <UniformGrid Rows="1">
                                            <Border Background="{StaticResource BgPanel}" CornerRadius="10"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="COUNTED" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding DetailCounted}" Style="{StaticResource MetricSmall}"
                                                               FontWeight="Bold" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DetailCountedSub}" Style="{StaticResource LabelSmall}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgPanel}" CornerRadius="10"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="UNIQUE" Style="{StaticResource Label}"/>
                                                    <!-- The only tile that gets a colour, because it is the only
                                                         one whose colour carries meaning. -->
                                                    <TextBlock Text="{Binding DetailUnique}" Style="{StaticResource MetricSmall}"
                                                               FontWeight="Bold" Foreground="{Binding DetailUniqueBrush}"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DetailUniqueSub}" Style="{StaticResource LabelSmall}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BgPanel}" CornerRadius="10"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                    Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="SESSION" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding DetailTotal}" Style="{StaticResource MetricSmall}"
                                                               FontWeight="Bold" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DetailTotalSub}" Style="{StaticResource LabelSmall}"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- originality -->
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="12"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                Padding="14" Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="64" Height="64">
                                                    <c:DonutRing Percent="{Binding DetailUniquePercent}"
                                                                 RingColor="{Binding DetailUniqueColor}"/>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DetailUniquePercentText}"
                                                                   Style="{StaticResource MetricSmall}" FontWeight="Bold"
                                                                   Foreground="{Binding DetailUniqueBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="%" Style="{StaticResource LabelSmall}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="ORIGINALITY" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="{Binding DetailVerdict}" Style="{StaticResource BodySmall}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2"
                                                                   Fill="{Binding DetailUniqueBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="unique" Style="{StaticResource BodySmall}"
                                                                   Foreground="{StaticResource TextDim}" Margin="6,0,0,0"/>
                                                        <TextBlock Text="{Binding DetailUniqueCount}" Style="{StaticResource Numeric}"
                                                                   Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2"
                                                                   Fill="{StaticResource SurfaceRaised}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="repeated" Style="{StaticResource BodySmall}"
                                                                   Foreground="{StaticResource TextDim}" Margin="6,0,0,0"/>
                                                        <TextBlock Text="{Binding DetailRepeatedCount}" Style="{StaticResource Numeric}"
                                                                   Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- speed -->
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="12"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                Padding="14" Margin="0,10,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="SPEED" Style="{StaticResource Label}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="peak " Style="{StaticResource BodySmall}"
                                                                   Foreground="{StaticResource TextFaint}"/>
                                                        <TextBlock Text="{Binding DetailPeak}" Style="{StaticResource Numeric}"/>
                                                        <TextBlock Text="{Binding RateUnit}" Style="{StaticResource BodySmall}"
                                                                   Foreground="{StaticResource TextFaint}" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding DetailRate}" Style="{StaticResource Metric}"/>
                                                    <TextBlock Text="{Binding RateUnit}" Style="{StaticResource BodySmall}"
                                                               Foreground="{StaticResource Accent}" Margin="5,0,0,4"
                                                               VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <Grid Margin="0,10,0,0">
                                                    <TextBlock Text="ACTIVITY · LAST 15 MIN" Style="{StaticResource Label}"
                                                               Foreground="{StaticResource TextFaint}"/>
                                                    <!-- The chart is peak-normalised, so without this the y-axis
                                                         would be unitless. -->
                                                    <TextBlock Text="{Binding DetailActivityScale}" Style="{StaticResource LabelSmall}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <c:AreaChart Height="52" Margin="0,6,0,0"
                                                             Values="{Binding DetailActivity}"
                                                             StrokeColor="{Binding Source={StaticResource Accent}, Path=Color}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- most repeated -->
                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding HasRepeated, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="MOST REPEATED" Style="{StaticResource Label}"/>
                                            <ItemsControl ItemsSource="{Binding Repeated}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource BgPanel}" CornerRadius="7"
                                                                Height="28" Margin="0,0,0,4" ClipToBounds="True">
                                                            <Grid>
                                                                <!-- Bar behind the text so the worst offenders are
                                                                     obvious without reading the numbers. -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource Frac}}"/>
                                                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FracRest}}"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#29FF6B7A" CornerRadius="7"/>
                                                                </Grid>
                                                                <Grid Margin="9,0">
                                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodySmall}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                                                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Numeric}"
                                                                               Foreground="{StaticResource Bad}"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- recent -->
                                        <TextBlock Text="{Binding RecentLabel}" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Recent}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" Style="{StaticResource LabelSmall}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                                   Style="{StaticResource BodySmall}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Rectangle Height="12"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </ContentControl>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ================= SETTINGS MODAL ================= -->
        <Grid x:Name="SettingsScrim" Background="#99000000"
              Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVis}}"
              MouseLeftButtonDown="OnScrimClicked">
            <ui:SettingsPanel x:Name="SettingsPanelHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
